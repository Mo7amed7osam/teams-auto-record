{
  "manifest_version": 3,
  "name": "Teams Auto Record",
  "version": "0.1.2",
  "description": "Safely automate recording and lobby access settings for matching Microsoft Teams Web meetings.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://outlook.office.com/*"
  ],
  "action": {
    "default_title": "Teams Auto Record",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://outlook.office.com/*"
      ],
      "all_frames": true,
      "js": [
        "shared/constants.js",
        "shared/utils.js",
        "shared/lobby-utils.js",
        "content/lobby-access.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
