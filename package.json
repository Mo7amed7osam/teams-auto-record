{
  "name": "teams-auto-record-workspace",
  "private": true,
  "version": "0.1.3",
  "description": "Workspace for the Teams Auto Record Chrome extension.",
  "scripts": {
    "clean": "node scripts/clean-extension.mjs",
    "test": "node --test tests/*.test.js",
    "build:dev": "node scripts/build-extension.mjs --mode=development",
    "build": "node scripts/build-extension.mjs --mode=minified",
    "build:protected": "node scripts/build-extension.mjs --mode=protected",
    "validate:dist": "node scripts/validate-extension.mjs",
    "package:zip": "node scripts/package-extension.mjs"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "javascript-obfuscator": "^4.1.1",
    "jsdom": "^29.1.1"
  }
}
