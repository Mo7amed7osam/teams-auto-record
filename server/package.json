{
  "name": "teams-license-api",
  "version": "1.0.0",
  "description": "Licensing backend for Teams Auto Record extension",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "license:generate": "node scripts/generate-license.js",
    "license:reset-device": "node scripts/reset-license-device.js",
    "license:disable": "node scripts/disable-license.js",
    "license:enable": "node scripts/enable-license.js",
    "license:inspect": "node scripts/inspect-license.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  }
}
